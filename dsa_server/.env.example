# Copy this file to `.env` and fill in the real password.
# `.env` is gitignored — it never gets committed, never sent anywhere.

DB_HOST=localhost
DB_PORT=3306
DB_USER=dsa_app_user
DB_PASSWORD=put-the-real-password-here
DB_NAME=dsa_db
PORT=8080

# Push notifications (Firebase). The path to the service-account key file
# downloaded from Firebase console > Project settings > Service accounts.
# Keep that file OUT of the project folder and out of git. Leave this empty
# and notifications are simply off.
FIREBASE_SERVICE_ACCOUNT=

# Email for "Forgot Password?" codes, through Brevo (brevo.com, free plan).
# BREVO_API_KEY: Brevo > SMTP & API > API keys > Generate. It's a secret.
# MAIL_FROM_EMAIL: a sender you verified in Brevo (Senders & IP). Once the
# club's domain is set up in Brevo, use an address on it (fewer spam folders).
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=DSA Elite Academy
