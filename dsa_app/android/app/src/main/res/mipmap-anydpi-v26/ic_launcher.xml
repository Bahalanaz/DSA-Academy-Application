<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ launcher icon: the club logo on the app's dark background.
     The launcher picks the shape (circle, squircle...); the logo sits in the
     safe zone so no shape cuts it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/app_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
