# For docker compose: copy this file to `.env` (next to docker-compose.yml)
# and choose your own passwords. `.env` is gitignored, never committed.
# Letters and digits only, so they're safe inside the setup script's SQL.

MYSQL_ROOT_PASSWORD=choose-a-root-password
DSA_DB_PASSWORD=choose-an-app-password

# Optional (email codes): see dsa_server/.env.example.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
